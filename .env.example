# ==============================================================================
# Переменные окружения для Cloudflare (Environment Variables)
# Настраиваются в панели Cloudflare:
# Workers & Pages -> Ваш проект -> Settings -> Variables and Secrets
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота от @BotFather
# Пример: 7123456789:AAFn8xJ9kLmNoPqRsTuVwXyZ1234567890
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [ОБЯЗАТЕЛЬНО] ID чата, группы или канала, куда бот будет присылать заявки
# - Для личных сообщений (ваш ID): 123456789
# - Для группы / супергруппы: -1001234567890
# (Чтобы узнать свой ID, напишите любое сообщение боту @userinfobot)
# ВАЖНО: Если бот пишет вам в личку, обязательно нажмите /start в диалоге с ботом!
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# [ОПЦИОНАЛЬНО] Прямая ссылка на диалог в Telegram с предустановленным сообщением
# Если задана, автоматически обновляет ссылку кнопки на сайте и в модальном окне успеха
TELEGRAM_LINK=https://t.me/m/cThxNnSsYTE6

# [ОПЦИОНАЛЬНО] ID темы (Topic / Message Thread ID), если заявки отправляются в супергруппу-форум
TELEGRAM_TOPIC_ID=

# ==============================================================================
# Facebook / Meta Conversions API (CAPI)
# ==============================================================================
# Токен доступа Conversions API (Генерируется в Meta Events Manager -> Настройки -> Сгенерировать маркер доступа)
FB_ACCESS_TOKEN=your_facebook_capi_access_token_here

# ID пикселя Facebook (по умолчанию используется 4047095728920722 из кода сайта)
FB_PIXEL_ID=4047095728920722

# [ОПЦИОНАЛЬНО] Код для проверки тестовых событий (из вкладки «Тестирование событий» / Test Events в Events Manager)
FB_TEST_EVENT_CODE=

