# ==============================================================================
# Переменные окружения для Cloudflare Pages (Environment Variables)
# Настраиваются в панели Cloudflare Dashboard:
# Workers & Pages -> Ваш проект -> Settings -> Environment variables
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота от @BotFather
# Пример: 7123456789:AAFn8xJ9kLmNoPqRsTuVwXyZ1234567890
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [ОБЯЗАТЕЛЬНО] ID чата, группы или канала, куда бот будет присылать заявки
# - Для личных сообщений (ваш ID): 123456789
# - Для группы / супергруппы: -1001234567890
# (Чтобы узнать ID, отправьте любое сообщение боту @userinfobot или добавьте @RawDataBot в группу)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# [ОПЦИОНАЛЬНО] ID темы (Topic / Message Thread ID), если заявки отправляются в конкретную ветку супергруппы
# Если чат обычный — оставьте пустым или не создавайте эту переменную
TELEGRAM_TOPIC_ID=
